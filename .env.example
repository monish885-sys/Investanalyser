# PersonaInvest - Multi-Agent Investment Analysis System
# Copy this file to .env and fill in your API keys.

# Upstox API (Bearer token from OAuth flow)
# Get token: https://upstox.com/developer/api-documentation/authentication
UPSTOX_ACCESS_TOKEN=8c031586-3654-479a-a9a6-6aac093a41ed

# HDFC Securities InvestRight Individual API
# Create app: https://developer.hdfcsec.com/
HDFC_API_KEY=
HDFC_API_SECRET=

# Google Gemini 1.5 Pro (AI Studio or Vertex)
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tavily Search (real-time news & web search)
# Get key: https://app.tavily.com/
TAVILY_API_KEY=

# Optional: Use mock portfolio data when APIs are not authenticated
# Set to true to test without broker connectivity
USE_MOCK_DATA=true
